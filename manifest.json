{
  "manifest_version": 3,
  "name": "WhisperLocal",
  "version": "1.0.8",
  "description": "A private audio/video transcriber powered by a local Whisper model.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "transcriber.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "transcriber.html",
        "worker.js",
        "lib/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}